{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qianxing.local/schemas/multi-account-joint-research-report-v1.json",
  "title": "Qianxing MultiAccountJointResearchReport v1",
  "description": "Replay-verified multi-exchange report facts with independent per-account event pages and no cross-venue event ordering.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "settlement_currency",
    "spec_fingerprint",
    "verification",
    "summary",
    "equity",
    "fills",
    "accounts"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "settlement_currency": {"type": "string", "minLength": 1},
    "spec_fingerprint": {"type": "string", "minLength": 1},
    "verification": {"$ref": "verification-result-v1.json"},
    "summary": {"$ref": "#/$defs/summary"},
    "equity": {"$ref": "#/$defs/equity"},
    "fills": {"$ref": "#/$defs/fills"},
    "accounts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/account"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "raw": {"type": "string", "pattern": "^-?[0-9]+$"},
    "summary": {
      "type": "object",
      "required": [
        "accounts_total",
        "markets_total",
        "initial_cash_raw",
        "final_equity_raw",
        "return_bps",
        "max_drawdown_bps",
        "successful_fills",
        "complete"
      ],
      "properties": {
        "accounts_total": {"type": "integer", "minimum": 2, "maximum": 32},
        "markets_total": {"type": "integer", "minimum": 1},
        "initial_cash_raw": {"$ref": "#/$defs/raw"},
        "final_equity_raw": {"$ref": "#/$defs/raw"},
        "return_bps": {"type": "integer"},
        "max_drawdown_bps": {"type": "integer", "minimum": 0},
        "successful_fills": {"type": "integer", "minimum": 0},
        "complete": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "equity": {
      "type": "object",
      "required": ["total", "truncated", "rows"],
      "properties": {
        "total": {"type": "integer", "minimum": 1},
        "truncated": {"type": "boolean"},
        "rows": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "type": "object",
            "required": ["ts", "equity_raw"],
            "properties": {
              "ts": {"type": "integer", "minimum": 0},
              "equity_raw": {"$ref": "#/$defs/raw"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "fills": {
      "type": "object",
      "required": ["total", "truncated", "rows"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "truncated": {"type": "boolean"},
        "rows": {"type": "array", "maxItems": 500, "items": {"type": "object"}}
      },
      "additionalProperties": false
    },
    "account": {
      "type": "object",
      "required": [
        "exchange_id",
        "account_id",
        "run_id",
        "initial_cash_raw",
        "final_equity_raw",
        "return_bps",
        "max_drawdown_bps",
        "markets_total",
        "strategies_total",
        "successful_fills",
        "equity_points",
        "data_fingerprint",
        "result_hash",
        "fill_rows_total",
        "fill_rows_truncated",
        "fill_rows",
        "event_rows_total",
        "event_rows_offset",
        "event_rows_limit",
        "event_rows_truncated",
        "event_rows_previous_offset",
        "event_rows_next_offset",
        "event_rows"
      ],
      "properties": {
        "exchange_id": {"type": "string", "minLength": 1},
        "account_id": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1},
        "initial_cash_raw": {"$ref": "#/$defs/raw"},
        "final_equity_raw": {"$ref": "#/$defs/raw"},
        "return_bps": {"type": "integer"},
        "max_drawdown_bps": {"type": "integer", "minimum": 0},
        "markets_total": {"type": "integer", "minimum": 1},
        "strategies_total": {"type": "integer", "minimum": 1},
        "successful_fills": {"type": "integer", "minimum": 0},
        "equity_points": {"type": "integer", "minimum": 1},
        "data_fingerprint": {"type": "string", "minLength": 1},
        "result_hash": {"type": "string", "minLength": 1},
        "fill_rows_total": {"type": "integer", "minimum": 0},
        "fill_rows_truncated": {"type": "boolean"},
        "fill_rows": {"type": "array", "maxItems": 500, "items": {"type": "object"}},
        "event_rows_total": {"type": "integer", "minimum": 0},
        "event_rows_offset": {"type": "integer", "minimum": 0},
        "event_rows_limit": {"type": "integer", "minimum": 1, "maximum": 300},
        "event_rows_truncated": {"type": "boolean"},
        "event_rows_previous_offset": {"type": ["integer", "null"], "minimum": 0},
        "event_rows_next_offset": {"type": ["integer", "null"], "minimum": 0},
        "event_rows": {"type": "array", "maxItems": 300, "items": {"type": "object"}}
      },
      "additionalProperties": false
    }
  }
}
