{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qianxing.local/schemas/strategy-api-input-v7.json",
  "title": "Qianxing Strategy API v7 — Input",
  "description": "策略输入 v7 增加账户余额与持仓的完整快照事实；可同时携带 v2-v6 的执行、成交、checkpoint、精确 OHLCV 与 L1 Tick 输入。快照是观察值，不修改 Rust 账本。",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "strategy_id",
    "strategy_version",
    "data_fingerprint",
    "as_of",
    "instrument",
    "positions",
    "cash",
    "risk_state",
    "research_targets",
    "market_ticks",
    "account_updates"
  ],
  "properties": {
    "schema_version": {
      "const": 7
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "strategy_id": {
      "type": "string",
      "minLength": 1
    },
    "strategy_version": {
      "type": "string",
      "minLength": 1
    },
    "data_fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "as_of": {
      "type": "integer",
      "minimum": 1
    },
    "instrument": {
      "type": "string",
      "minLength": 1
    },
    "positions": {
      "$ref": "#/$defs/raw_ledger"
    },
    "positions_exact": {
      "$ref": "#/$defs/exact_signed_ledger"
    },
    "cash": {
      "$ref": "#/$defs/raw_ledger"
    },
    "available_margin_raw": {
      "$ref": "#/$defs/optional_raw_non_negative"
    },
    "risk_state": {
      "type": "string",
      "minLength": 1
    },
    "research_targets": {
      "$ref": "#/$defs/raw_ledger"
    },
    "bars": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/bars"
        }
      ]
    },
    "market_bars": {
      "description": "主 bars 之外的市场历史，键为完整 InstrumentId；所有 Bar 都不得晚于 as_of。",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/bars"
      }
    },
    "execution_updates": {
      "type": "array",
      "items": {
        "$ref": "strategy-order-status-update-v1.json"
      }
    },
    "fill_updates": {
      "type": "array",
      "items": {
        "$ref": "strategy-fill-update-v2.json"
      }
    },
    "strategy_checkpoint": {
      "$ref": "#/$defs/checkpoint"
    },
    "market_ticks": {
      "description": "按 (ts, stream_id, event_seq) 严格排序的冻结行情事件；非空时使用 input v6。",
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/market_tick"
      }
    },
    "account_updates": {
      "description": "按 (ts, account_id, venue_id, event_seq) 严格递增的完整账户事实；空 balances/positions 代表完整空快照。",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/account_update"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "raw_signed": {
      "description": "核心定点 raw 值（Rust i128，可负）：只允许 JSON 整数。持仓可为空头、现金在保证金账户可为负，所以这里不能收窄成非负。",
      "type": "integer"
    },
    "raw_non_negative": {
      "description": "必须非负的定点 raw 值（Rust 侧 `available_margin_raw` 的 validate 同样拒绝负数）。",
      "type": "integer",
      "minimum": 0
    },
    "optional_raw_non_negative": {
      "description": "可缺省的可用保证金：null 表示运行时未计算这一格，而不是算出来是零（与产物里 Option<i128> 的诚实语义一致）。",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/raw_non_negative"
        }
      ]
    },
    "raw_ledger": {
      "description": "以 InstrumentId 为键，或以 `account_id|InstrumentId` 为键（多账户持仓）的定点 raw 值账。键不在 schema 里做词法约束：那是运行时 validate 的职责，schema 只钉形态。",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/raw_signed"
      }
    },
    "exact_signed_ledger": {
      "description": "精确的有符号十进制持仓数量，以 InstrumentId 或 `account_id|InstrumentId` 为键；十进制字符串最多 18 位小数。",
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
      }
    },
    "bars": {
      "type": "object",
      "required": [
        "source",
        "ts",
        "open_raw",
        "high_raw",
        "low_raw",
        "close_raw",
        "volume_raw"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "ts": {
          "description": "严格递增的毫秒时间戳（Rust 侧 `StrategyContractBars::validate` 同样拒绝重复与倒序）。",
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "open_raw": {
          "$ref": "#/$defs/raw_series"
        },
        "high_raw": {
          "$ref": "#/$defs/raw_series"
        },
        "low_raw": {
          "$ref": "#/$defs/raw_series"
        },
        "close_raw": {
          "$ref": "#/$defs/raw_series"
        },
        "volume_raw": {
          "$ref": "#/$defs/raw_series"
        },
        "exact_ohlcv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/exact_ohlcv"
              }
            ]
          },
          "description": "Optional row-aligned exact source values; v5 input requires at least one non-null row across bars and market_bars."
        }
      },
      "additionalProperties": false
    },
    "raw_series": {
      "description": "一列定点 raw 值；Rust 侧只校验五列等长，不校验正负，故这里保持 raw_signed。",
      "type": "array",
      "items": {
        "$ref": "#/$defs/raw_signed"
      }
    },
    "checkpoint": {
      "type": "object",
      "required": [
        "schema_version",
        "strategy_id",
        "strategy_version",
        "adapter_state",
        "strategy_state"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "strategy_id": {
          "type": "string",
          "minLength": 1
        },
        "strategy_version": {
          "type": "string",
          "minLength": 1
        },
        "adapter_state": {
          "type": "object",
          "additionalProperties": true
        },
        "strategy_state": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false,
      "description": "Runtime additionally checks identity binding and a maximum encoded size of 64 KiB."
    },
    "exact_decimal": {
      "type": "object",
      "required": [
        "coefficient",
        "scale"
      ],
      "properties": {
        "coefficient": {
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)$",
          "maxLength": 40
        },
        "scale": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18
        }
      },
      "additionalProperties": false,
      "description": "ExactDecimal uses a normalized signed i128 coefficient encoded as text and a decimal scale."
    },
    "exact_ohlcv": {
      "type": "object",
      "required": [
        "open",
        "high",
        "low",
        "close",
        "volume"
      ],
      "properties": {
        "open": {
          "$ref": "#/$defs/exact_decimal"
        },
        "high": {
          "$ref": "#/$defs/exact_decimal"
        },
        "low": {
          "$ref": "#/$defs/exact_decimal"
        },
        "close": {
          "$ref": "#/$defs/exact_decimal"
        },
        "volume": {
          "$ref": "#/$defs/exact_decimal"
        }
      },
      "additionalProperties": false,
      "description": "Authoritative source-precision OHLCV. Rust and Python also validate value ranges and each 1e-9 raw projection."
    },
    "market_tick": {
      "type": "object",
      "required": [
        "stream_id",
        "event_seq",
        "source_seq",
        "ts",
        "instrument",
        "bid_raw",
        "ask_raw",
        "bid_qty_raw",
        "ask_qty_raw"
      ],
      "properties": {
        "stream_id": {
          "type": "string",
          "minLength": 1
        },
        "event_seq": {
          "type": "integer",
          "minimum": 0
        },
        "source_seq": {
          "type": "integer",
          "minimum": 0
        },
        "ts": {
          "type": "integer",
          "minimum": 1
        },
        "instrument": {
          "type": "string",
          "minLength": 1
        },
        "bid_raw": {
          "type": "integer",
          "minimum": 1
        },
        "ask_raw": {
          "type": "integer",
          "minimum": 1
        },
        "bid_qty_raw": {
          "type": "integer",
          "minimum": 0
        },
        "ask_qty_raw": {
          "type": "integer",
          "minimum": 0
        },
        "bid_exact": {
          "type": "string",
          "minLength": 1
        },
        "ask_exact": {
          "type": "string",
          "minLength": 1
        },
        "bid_qty_exact": {
          "type": "string",
          "minLength": 1
        },
        "ask_qty_exact": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "description": "Exact decimal sidecars retain venue precision. Runtime additionally checks raw projections, bid <= ask, instrument identity, timestamp <= as_of, and unique ordered EventLog identities."
    },
    "exact_balance_amounts": {
      "type": "object",
      "required": [
        "free",
        "locked",
        "borrowed"
      ],
      "properties": {
        "free": {
          "$ref": "#/$defs/exact_decimal"
        },
        "locked": {
          "$ref": "#/$defs/exact_decimal"
        },
        "borrowed": {
          "$ref": "#/$defs/exact_decimal"
        },
        "net_cash_balance": {
          "$ref": "#/$defs/exact_decimal"
        }
      },
      "additionalProperties": false
    },
    "exact_position_amounts": {
      "type": "object",
      "required": [
        "quantity"
      ],
      "properties": {
        "quantity": {
          "$ref": "#/$defs/exact_decimal"
        },
        "average_price": {
          "$ref": "#/$defs/exact_decimal"
        },
        "mark_price": {
          "$ref": "#/$defs/exact_decimal"
        },
        "liquidation_price": {
          "$ref": "#/$defs/exact_decimal"
        },
        "unrealized_pnl": {
          "$ref": "#/$defs/exact_decimal"
        },
        "initial_margin": {
          "$ref": "#/$defs/exact_decimal"
        },
        "maintenance_margin": {
          "$ref": "#/$defs/exact_decimal"
        }
      },
      "additionalProperties": false
    },
    "account_update": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "schema_version",
            "event",
            "event_seq",
            "ts",
            "account_id",
            "venue_id",
            "balances"
          ],
          "properties": {
            "schema_version": {
              "const": 1
            },
            "event_seq": {
              "type": "integer",
              "minimum": 0
            },
            "ts": {
              "type": "integer",
              "minimum": 1
            },
            "account_id": {
              "type": "string",
              "minLength": 1
            },
            "venue_id": {
              "type": "string",
              "minLength": 1
            },
            "event": {
              "const": "account_snapshot"
            },
            "balances": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/account_balance"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "schema_version",
            "event",
            "event_seq",
            "ts",
            "account_id",
            "venue_id",
            "positions"
          ],
          "properties": {
            "schema_version": {
              "const": 1
            },
            "event_seq": {
              "type": "integer",
              "minimum": 0
            },
            "ts": {
              "type": "integer",
              "minimum": 1
            },
            "account_id": {
              "type": "string",
              "minLength": 1
            },
            "venue_id": {
              "type": "string",
              "minLength": 1
            },
            "event": {
              "const": "position_snapshot"
            },
            "positions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/account_position"
              }
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "Rust additionally validates event identity, exact-to-raw projections, scope and as_of."
    },
    "account_balance": {
      "type": "object",
      "required": [
        "asset",
        "free",
        "locked",
        "borrowed"
      ],
      "properties": {
        "asset": {
          "type": "string",
          "minLength": 1
        },
        "free": {
          "$ref": "#/$defs/raw_signed"
        },
        "locked": {
          "$ref": "#/$defs/raw_signed"
        },
        "borrowed": {
          "$ref": "#/$defs/raw_signed"
        },
        "net_cash_balance": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/raw_signed"
            }
          ]
        },
        "exact_amounts": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/exact_balance_amounts"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "account_position": {
      "type": "object",
      "required": [
        "instrument",
        "quantity"
      ],
      "properties": {
        "instrument": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object",
              "required": [
                "symbol",
                "venue"
              ],
              "properties": {
                "symbol": {
                  "type": "string",
                  "minLength": 1
                },
                "venue": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "settlement_currency": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "quantity": {
          "$ref": "#/$defs/raw_signed"
        },
        "average_price": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/raw_signed"
            }
          ]
        },
        "mark_price": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/raw_signed"
            }
          ]
        },
        "liquidation_price": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/raw_signed"
            }
          ]
        },
        "unrealized_pnl": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/raw_signed"
            }
          ]
        },
        "initial_margin": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/raw_signed"
            }
          ]
        },
        "maintenance_margin": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/raw_signed"
            }
          ]
        },
        "leverage": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            }
          ]
        },
        "margin_mode": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "position_side": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "exact_amounts": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/exact_position_amounts"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
