{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qianxing.local/schemas/algo-execution-plan-v1.json",
  "title": "Qianxing AlgoExecutionPlan v1",
  "description": "Immutable parent-linked child schedule returned by the Rust algorithm execution planner; it does not submit orders.",
  "type": "object",
  "required": ["schema_version", "method", "parent_id", "children"],
  "properties": {
    "schema_version": {"const": 1},
    "method": {"enum": ["twap", "vwap"]},
    "parent_id": {"type": "string", "minLength": 1},
    "children": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/AlgoChildSlice"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "AlgoChildSlice": {
      "type": "object",
      "required": ["parent_id", "child_index", "scheduled_ts", "quantity_raw"],
      "properties": {
        "parent_id": {"type": "string", "minLength": 1},
        "child_index": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "scheduled_ts": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "quantity_raw": {"type": "integer", "minimum": 1, "maximum": 170141183460469231731687303715884105727}
      },
      "additionalProperties": false
    }
  }
}
