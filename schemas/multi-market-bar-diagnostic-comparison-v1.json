{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qianxing.local/schemas/multi-market-bar-diagnostic-comparison-v1.json",
  "title": "Qianxing Multi-market Bar Diagnostic Comparison v1",
  "description": "为相同输入的多市场 Bar 运行绑定逐运行策略偏差诊断。run_id 集合必须与 report --against 完全一致；CLI 会重开摘要并复核策略槽、标的、输入指纹和覆盖边界。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "runs"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "qianxing-multi-market-bar-diagnostic-comparison" },
    "runs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_id", "diagnostics"],
        "properties": {
          "run_id": { "type": "string", "minLength": 1 },
          "diagnostics": {
            "type": "array",
            "minItems": 1,
            "maxItems": 512,
            "items": {
              "type": "object",
              "required": [
                "schema_version", "kind", "strategy_id", "instrument",
                "data_fingerprint", "input_bars", "as_of", "lookahead", "startup"
              ],
              "properties": {
                "schema_version": { "const": 1 },
                "kind": { "const": "qianxing-strategy-bias-diagnostics" },
                "strategy_id": { "type": "string", "minLength": 1 },
                "instrument": { "type": "string", "minLength": 1 },
                "data_fingerprint": { "type": "string", "minLength": 1 },
                "input_kind": { "const": "bar" },
                "input_bars": { "type": "integer", "minimum": 0 },
                "as_of": { "type": "integer", "minimum": 0 },
                "lookahead": {
                  "type": "object",
                  "required": ["status"],
                  "properties": {
                    "status": {
                      "enum": ["potential_lookahead_detected", "no_change_detected", "insufficient_history", "insufficient_work_budget", "causal_event_contract"]
                    }
                  }
                },
                "startup": {
                  "type": "object",
                  "required": ["status"],
                  "properties": {
                    "status": {
                      "enum": ["startup_sensitive", "stable_across_requested_windows", "insufficient_reference_history", "insufficient_history"]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
