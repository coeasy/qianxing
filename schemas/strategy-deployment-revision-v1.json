{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qianxing.local/schemas/strategy-deployment-revision-v1.json",
  "title": "Qianxing Strategy Deployment Revision V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "worker_id", "revision", "bundle_sha256", "plan_sha256", "desired_running", "created_at_ms", "created_by"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "qianxing_strategy_deployment_revision"},
    "worker_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "revision": {"type": "integer", "minimum": 1},
    "bundle_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "bundle_file_name": {"type": "string", "pattern": "^[0-9a-f]{64}\\.[A-Za-z0-9]{1,16}$"},
    "runtime_config_json": {"type": "string", "minLength": 2, "maxLength": 4194304, "description": "Frozen full RuntimeConfig JSON payload; new API revisions require it."},
    "runtime_config_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "dependency_tree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "entry_path", "tree_sha256", "files"],
      "properties": {
        "schema_version": {"const": 1},
        "kind": {"const": "qianxing_strategy_dependency_tree"},
        "entry_path": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)[^\\\\:]+$"},
        "tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2048,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "size_bytes", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)[^\\\\:]+\\.py$"},
              "size_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
              "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
            }
          }
        }
      }
    },
    "desired_running": {"type": "boolean"},
    "created_at_ms": {"type": "integer", "minimum": 0},
    "created_by": {"type": "string", "minLength": 1, "maxLength": 256}
  },
  "dependentRequired": {
    "runtime_config_json": ["runtime_config_sha256"],
    "runtime_config_sha256": ["runtime_config_json"]
  }
}
