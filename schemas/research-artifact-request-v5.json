{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qianxing.local/schemas/research-artifact-request-v5.json",
  "title": "Qianxing ResearchArtifactRequest v5",
  "description": "Verified research artifact request with identity-bound diagnostics for Bar and L1/L2 depth strategy inputs.",
  "anyOf": [
    {
      "$ref": "backtest-outcome-v1.json"
    },
    {
      "$ref": "depth-backtest-outcome-v1.json"
    },
    {
      "$ref": "multi-market-backtest-outcome-v1.json"
    },
    {
      "$ref": "multi-market-depth-backtest-outcome-v1.json"
    },
    {
      "$ref": "multi-account-backtest-result-v1.json"
    },
    {
      "$ref": "multi-account-backtest-result-v2.json"
    },
    {
      "$ref": "multi-account-depth-backtest-result-v1.json"
    },
    {
      "$ref": "multi-account-depth-backtest-result-v2.json"
    },
    {
      "type": "object",
      "required": [
        "outcome"
      ],
      "properties": {
        "outcome": {
          "anyOf": [
            {
              "$ref": "backtest-outcome-v1.json"
            },
            {
              "$ref": "depth-backtest-outcome-v1.json"
            },
            {
              "$ref": "multi-market-backtest-outcome-v1.json"
            },
            {
              "$ref": "multi-market-depth-backtest-outcome-v1.json"
            },
            {
              "$ref": "multi-account-backtest-result-v1.json"
            },
            {
              "$ref": "multi-account-backtest-result-v2.json"
            },
            {
              "$ref": "multi-account-depth-backtest-result-v1.json"
            },
            {
              "$ref": "multi-account-depth-backtest-result-v2.json"
            }
          ]
        },
        "strategy_diagnostics": {
          "type": "object",
          "required": [
            "schema_version",
            "kind",
            "strategy_id",
            "instrument",
            "data_fingerprint",
            "as_of",
            "lookahead",
            "startup"
          ],
          "properties": {
            "schema_version": {
              "const": 1
            },
            "kind": {
              "const": "qianxing-strategy-bias-diagnostics"
            },
            "strategy_id": {
              "type": "string",
              "minLength": 1
            },
            "instrument": {
              "type": "string",
              "minLength": 1
            },
            "data_fingerprint": {
              "type": "string",
              "minLength": 1
            },
            "as_of": {
              "type": "integer",
              "minimum": 0
            },
            "input_bars": {
              "type": "integer",
              "minimum": 1
            },
            "lookahead": {
              "type": "object"
            },
            "startup": {
              "type": "object"
            },
            "input_events": {
              "type": "integer",
              "minimum": 1
            },
            "input_kind": {
              "enum": [
                "tick",
                "order_book",
                "depth_midpoint_bar"
              ]
            }
          },
          "additionalProperties": true,
          "oneOf": [
            {
              "required": [
                "input_bars"
              ]
            },
            {
              "required": [
                "input_events",
                "input_kind"
              ]
            }
          ]
        },
        "event_page": {
          "type": "object",
          "required": [
            "offset"
          ],
          "properties": {
            "offset": {
              "type": "integer",
              "minimum": 0
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300,
              "default": 300
            }
          },
          "additionalProperties": false
        },
        "account_event_offsets": {
          "type": "object",
          "description": "Per-account event cursors used to page the chronologically merged multi-account event timeline. The sum of these offsets must match event_page.offset.",
          "maxProperties": 32,
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "event_instrument": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "market_strategy_diagnostics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": {
            "type": "object",
            "required": [
              "schema_version",
              "kind",
              "strategy_id",
              "instrument",
              "data_fingerprint",
              "as_of",
              "lookahead",
              "startup"
            ],
            "properties": {
              "schema_version": {
                "const": 1
              },
              "kind": {
                "const": "qianxing-strategy-bias-diagnostics"
              },
              "strategy_id": {
                "type": "string",
                "minLength": 1
              },
              "instrument": {
                "type": "string",
                "minLength": 1
              },
              "data_fingerprint": {
                "type": "string",
                "minLength": 1
              },
              "as_of": {
                "type": "integer",
                "minimum": 0
              },
              "input_bars": {
                "type": "integer",
                "minimum": 1
              },
              "lookahead": {
                "type": "object"
              },
              "startup": {
                "type": "object"
              },
              "input_events": {
                "type": "integer",
                "minimum": 1
              },
              "input_kind": {
                "enum": [
                  "tick",
                  "order_book",
                  "depth_midpoint_bar"
                ]
              }
            },
            "additionalProperties": true,
            "oneOf": [
              {
                "required": [
                  "input_bars"
                ]
              },
              {
                "required": [
                  "input_events",
                  "input_kind"
                ]
              }
            ]
          }
        },
        "account_strategy_diagnostics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "description": "At most one diagnostics entry per successful account; each entry is rebound to that account’s independently verified run identity.",
          "items": {
            "type": "object",
            "required": [
              "account_id"
            ],
            "properties": {
              "account_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "strategy_diagnostics": {
                "$ref": "#/anyOf/6/properties/strategy_diagnostics"
              },
              "market_strategy_diagnostics": {
                "$ref": "#/anyOf/6/properties/market_strategy_diagnostics"
              }
            },
            "oneOf": [
              {
                "required": [
                  "strategy_diagnostics"
                ]
              },
              {
                "required": [
                  "market_strategy_diagnostics"
                ]
              }
            ],
            "additionalProperties": false
          }
        }
      },
      "not": {
        "required": [
          "strategy_diagnostics",
          "market_strategy_diagnostics"
        ]
      },
      "additionalProperties": false,
      "allOf": [
        {
          "not": {
            "required": [
              "account_strategy_diagnostics",
              "strategy_diagnostics"
            ]
          }
        },
        {
          "not": {
            "required": [
              "account_strategy_diagnostics",
              "market_strategy_diagnostics"
            ]
          }
        }
      ]
    }
  ]
}
