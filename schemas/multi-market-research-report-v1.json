{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qianxing.local/schemas/multi-market-research-report-v1.json",
  "title": "Multi-market Research Report V1",
  "description": "Replay-verified bounded report for a shared-account multi-market Bar run. Legacy raw values and optional scale-aware exact decimal values are decimal strings.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "account_id", "instrument", "spec_fingerprint", "verification", "summary", "equity", "fills", "events", "markets"],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "account_id": { "type": "string", "minLength": 1 },
    "instrument": { "type": "string", "minLength": 1 },
    "spec_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "verification": { "$ref": "https://qianxing.local/schemas/verification-result-v1.json" },
    "summary": { "$ref": "#/$defs/summary" },
    "equity": { "$ref": "#/$defs/equityRows" },
    "fills": { "$ref": "#/$defs/fillRows" },
    "events": { "$ref": "#/$defs/eventPage" },
    "markets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/market" }
    }
  },
  "$defs": {
    "rows": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "truncated", "rows"],
      "properties": {
        "total": { "type": "integer", "minimum": 0, "maximum": 5000000 },
        "truncated": { "type": "boolean" },
        "rows": { "type": "array" }
      }
    },
    "equityRows": {
      "allOf": [
        { "$ref": "#/$defs/rows" },
        {
          "properties": {
            "rows": {
              "maxItems": 1000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["ts", "equity_raw"],
                "properties": {
                  "ts": { "type": "string", "pattern": "^-?[0-9]+$" },
                    "equity_raw": { "type": "string", "pattern": "^-?[0-9]+$" },
                    "equity_exact": { "type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$" }
                }
              }
            }
          }
        }
      ]
    },
    "fillRows": {
      "allOf": [
        { "$ref": "#/$defs/rows" },
        { "properties": { "rows": { "maxItems": 200 } } }
      ]
    },
    "barRows": {
      "allOf": [
        { "$ref": "#/$defs/rows" },
        {
          "properties": {
            "rows": {
              "maxItems": 1000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["ts", "open_raw", "high_raw", "low_raw", "close_raw", "volume_raw"],
                "properties": {
                  "ts": { "type": "integer", "minimum": 0 },
                  "open_raw": { "type": "string", "pattern": "^-?[0-9]+$" },
                  "high_raw": { "type": "string", "pattern": "^-?[0-9]+$" },
                  "low_raw": { "type": "string", "pattern": "^-?[0-9]+$" },
                  "close_raw": { "type": "string", "pattern": "^-?[0-9]+$" },
                  "volume_raw": { "type": "string", "pattern": "^-?[0-9]+$" }
                }
              }
            }
          }
        }
      ]
    },
    "contributionRows": {
      "allOf": [
        { "$ref": "#/$defs/rows" },
        {
          "properties": {
            "rows": {
              "maxItems": 1000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["equity_index", "ts", "pnl_contribution_raw"],
                "properties": {
                  "equity_index": { "type": "integer", "minimum": 0 },
                  "ts": { "type": "integer", "minimum": 0 },
                  "pnl_contribution_raw": { "type": "string", "pattern": "^-?[0-9]+$" },
                  "pnl_contribution_exact": { "type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$" }
                }
              }
            }
          }
        }
      ]
    },
    "market": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instrument", "strategy_ids", "data_fingerprint", "fill_count", "quality_status", "source_end_ts", "bars", "pnl_contribution"],
      "properties": {
        "instrument": { "type": "string", "minLength": 1 },
        "strategy_ids": { "type": "array", "maxItems": 16, "items": { "type": "string", "minLength": 1 } },
        "data_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "fill_count": { "type": "integer", "minimum": 0 },
        "quality_status": { "type": "string", "minLength": 1 },
        "source_end_ts": { "type": "integer", "minimum": 0 },
        "bars": { "$ref": "#/$defs/barRows" },
        "pnl_contribution": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/contributionRows" }
          ]
        }
      }
    },
    "eventPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "run_id", "total", "offset", "truncated", "rows", "fill_count", "fill_sequence_sha256", "replayed_ledger_entries"],
      "properties": {
        "schema_version": { "const": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "total": { "type": "integer", "minimum": 0, "maximum": 5000000 },
        "offset": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" },
        "rows": { "type": "array", "maxItems": 300, "items": { "type": "object" } },
        "fill_count": { "type": "integer", "minimum": 0 },
        "fill_sequence_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "replayed_ledger_entries": { "type": "integer", "minimum": 0 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "account_id", "markets_total", "strategies_total", "execution_assumptions", "successful_fills", "fills", "event_count", "account", "metrics", "result_hash", "data_fingerprint", "spec_fingerprint", "markets"],
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "account_id": { "type": "string", "minLength": 1 },
        "markets_total": { "type": "integer", "minimum": 1, "maximum": 32 },
        "strategies_total": { "type": "integer", "minimum": 1, "maximum": 512 },
        "execution_assumptions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["settlement_currency", "markets"],
          "properties": {
            "settlement_currency": { "type": "string", "minLength": 1 },
            "markets": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["instrument", "priority", "market_spec", "market_spec_json", "fee_schedule", "order_policy", "margin_model", "funding_bps", "funding_events"],
                "properties": {
                  "instrument": { "type": "string", "minLength": 1 },
                  "priority": { "type": "integer", "minimum": 0 },
                  "market_spec": { "type": "object", "additionalProperties": true },
                  "market_spec_json": { "type": "string", "minLength": 2, "maxLength": 16384 },
                  "fee_schedule": {
                    "oneOf": [
                      { "type": "null" },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["maker_fee_bps", "taker_fee_bps"],
                        "properties": {
                          "maker_fee_bps": { "type": "integer" },
                          "taker_fee_bps": { "type": "integer" }
                        }
                      }
                    ]
                  },
                  "order_policy": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["reduce_only", "position_side", "margin_mode", "position_mode", "leverage", "post_only"],
                    "properties": {
                      "reduce_only": { "type": "boolean" },
                      "position_side": { "enum": ["net", "long", "short"] },
                      "margin_mode": { "enum": ["cash", "cross", "isolated"] },
                      "position_mode": { "enum": ["one_way", "hedge"] },
                      "leverage": { "type": "integer", "minimum": 1 },
                      "post_only": { "type": "boolean" }
                    }
                  },
                  "margin_model": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "tiers_total", "tiers_truncated", "tiers_sha256", "tiers"],
                    "properties": {
                      "kind": { "enum": ["no_margin", "leverage", "tiers"] },
                      "leverage": { "type": "integer", "minimum": 1 },
                      "maintenance_bp": { "type": "integer", "minimum": 0, "maximum": 10000 },
                      "tiers_total": { "type": "integer", "minimum": 0, "maximum": 100000 },
                      "tiers_truncated": { "type": "boolean" },
                      "tiers_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                      "tiers": {
                        "type": "array",
                        "maxItems": 100,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["max_notional_raw", "initial_bp", "maintenance_bp", "max_leverage"],
                          "properties": {
                            "max_notional_raw": { "type": "string", "pattern": "^-?[0-9]+$" },
                            "initial_bp": { "type": "integer", "minimum": 0, "maximum": 10000 },
                            "maintenance_bp": { "type": "integer", "minimum": 0, "maximum": 10000 },
                            "max_leverage": { "type": ["integer", "null"], "minimum": 1 }
                          }
                        }
                      }
                    }
                  },
                  "funding_bps": { "type": "integer" },
                  "funding_events": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["total", "truncated", "sha256", "rows"],
                    "properties": {
                      "total": { "type": "integer", "minimum": 0, "maximum": 100000 },
                      "truncated": { "type": "boolean" },
                      "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                      "rows": {
                        "type": "array",
                        "maxItems": 100,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["instrument", "settlement_ts", "rate_bps"],
                          "properties": {
                            "instrument": { "type": "object" },
                            "settlement_ts": { "type": "integer", "minimum": 0 },
                            "rate_bps": { "type": "integer", "minimum": -10000, "maximum": 10000 }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "successful_fills": { "type": "integer", "minimum": 0 },
        "fills": { "type": "integer", "minimum": 0 },
        "event_count": { "type": "integer", "minimum": 0, "maximum": 5000000 },
        "account": {
          "type": "object",
          "additionalProperties": false,
          "required": ["account_id", "initial_cash_raw"],
          "properties": {
            "account_id": { "type": "string", "minLength": 1 },
            "initial_cash_raw": { "type": "string", "pattern": "^-?[0-9]+$" }
          }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["return_bps", "max_drawdown_bps", "final_equity_raw"],
          "properties": {
            "return_bps": { "type": "integer" },
            "max_drawdown_bps": { "type": "integer", "minimum": 0 },
            "final_equity_raw": { "type": "string", "pattern": "^-?[0-9]+$" }
          }
        },
        "result_hash": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "data_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "spec_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "markets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["instrument", "data_fingerprint", "fills", "quality_status", "bar_count"],
            "properties": {
              "instrument": { "type": "string", "minLength": 1 },
              "data_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
              "fills": { "type": "integer", "minimum": 0 },
              "quality_status": { "type": "string", "minLength": 1 },
              "bar_count": { "type": "integer", "minimum": 0, "maximum": 5000000 }
            }
          }
        }
      }
    }
  }
}
