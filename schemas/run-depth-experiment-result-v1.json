{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qianxing.local/schemas/run-depth-experiment-result-v1.json",
  "title": "Qianxing RunDepthExperimentResult v1",
  "description": "Bounded Tick/OrderBook experiment output with candidate isolation and deterministic return/drawdown ranking.",
  "type": "object",
  "required": ["schema_version", "experiment_id", "spec_fingerprint", "total_candidates", "completed_candidates", "succeeded_candidates", "failed_candidates", "candidates", "ranking", "artifact_path"],
  "properties": {
    "schema_version": {"const": 1},
    "experiment_id": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[A-Za-z0-9._-]+$"},
    "spec_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "total_candidates": {"type": "integer", "minimum": 1, "maximum": 256},
    "completed_candidates": {"type": "integer", "minimum": 0, "maximum": 256},
    "succeeded_candidates": {"type": "integer", "minimum": 0, "maximum": 256},
    "failed_candidates": {"type": "integer", "minimum": 0, "maximum": 256},
    "candidates": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/Candidate"}},
    "ranking": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/RankedCandidate"}},
    "artifact_path": {"type": "string", "minLength": 1},
    "canonical_run_spec_json": {"type": "string", "minLength": 1},
    "canonical_run_spec_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "input_data_fingerprint": {"type": "string", "minLength": 1},
    "result_hash": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "run_manifest": {"type": "string", "minLength": 1},
    "run_record": {"type": "string", "minLength": 1},
    "artifact_locations": {
      "type": "object",
      "required": ["experiment_report", "run_manifest"],
      "properties": {
        "experiment_report": {"type": "string", "minLength": 1},
        "run_manifest": {"type": "string", "minLength": 1},
        "experiment_input": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "not": {
        "anyOf": [
          {"required": ["canonical_run_spec_json"]},
          {"required": ["canonical_run_spec_fingerprint"]},
          {"required": ["input_data_fingerprint"]},
          {"required": ["result_hash"]},
          {"required": ["run_manifest"]},
          {"required": ["run_record"]},
          {"required": ["artifact_locations"]}
        ]
      }
    },
    {
      "required": ["canonical_run_spec_json", "canonical_run_spec_fingerprint", "input_data_fingerprint", "result_hash", "run_manifest", "run_record", "artifact_locations"]
    }
  ],
  "allOf": [
    {
      "if": {"required": ["result_hash"]},
      "then": {"required": ["canonical_run_spec_json", "canonical_run_spec_fingerprint", "input_data_fingerprint", "run_manifest", "run_record", "artifact_locations"]}
    },
    {
      "if": {"required": ["canonical_run_spec_json"]},
      "then": {"required": ["canonical_run_spec_fingerprint", "input_data_fingerprint"]}
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "Candidate": {
      "type": "object",
      "required": ["ordinal", "parameters", "outcome", "error"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 255},
        "strategy_kind": {"enum": ["sma_cross", "ema_cross", "macd", "rsi", "bollinger", "donchian_breakout", "momentum", "mean_reversion", "grid", "atr_trend", "keltner_trend", "vwap_reversion", "volatility_breakout"]},
        "parameters": {"type": "object", "additionalProperties": {"type": "integer", "minimum": -170141183460469231731687303715884105728, "maximum": 170141183460469231731687303715884105727}},
        "outcome": {"anyOf": [{"$ref": "depth-backtest-outcome-v1.json"}, {"type": "null"}]},
        "error": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "RankedCandidate": {
      "type": "object",
      "required": ["rank", "ordinal", "run_id", "return_bps", "max_drawdown_bps", "result_hash"],
      "properties": {
        "rank": {"type": "integer", "minimum": 1, "maximum": 256},
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 255},
        "run_id": {"type": "string", "minLength": 1},
        "return_bps": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
        "max_drawdown_bps": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "result_hash": {"type": "string", "pattern": "^[0-9a-f]{16}$"}
      },
      "additionalProperties": false
    }
  }
}
