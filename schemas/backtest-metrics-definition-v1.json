{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qianxing.local/schemas/backtest-metrics-definition-v1.json",
  "title": "Qianxing backtest metric definitions v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "risk_ratio_period_basis",
    "benchmark_period_basis",
    "fees_exact_basis",
    "fees_raw_basis"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "risk_ratio_period_basis": {
      "const": "per_sample_no_annualization"
    },
    "benchmark_period_basis": {
      "const": "exact_timestamp_aligned_observations_no_annualization"
    },
    "fees_exact_basis": {
      "const": "ledger_fee_entries_grouped_by_currency"
    },
    "fees_raw_basis": {
      "const": "compatibility_projection_only"
    }
  }
}
