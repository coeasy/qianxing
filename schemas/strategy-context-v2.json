{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qianxing.dev/schemas/strategy-context-v2.json",
  "title": "Qianxing Exact Strategy Context v2",
  "description": "Normalized contract represented by the optional qx_strategy_on_context_v2 C ABI callback. The ABI envelope carries a stable qx_strategy_context v1 projection plus exact position, cash, and margin sidecars.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "context_v1",
    "positions_exact",
    "cash_exact",
    "available_margin_exact"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "context_v1": { "$ref": "#/$defs/context_v1" },
    "positions_exact": {
      "type": "array",
      "items": { "$ref": "#/$defs/exact_kv" },
      "uniqueItems": true
    },
    "cash_exact": {
      "type": "array",
      "items": { "$ref": "#/$defs/exact_kv" },
      "uniqueItems": true
    },
    "available_margin_exact": {
      "oneOf": [
        { "$ref": "#/$defs/decimal" },
        { "type": "null" }
      ]
    }
  },
  "$defs": {
    "decimal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coefficient", "scale"],
      "properties": {
        "coefficient": { "type": "string", "pattern": "^-?(0|[1-9][0-9]*)$" },
        "scale": { "type": "integer", "minimum": 0, "maximum": 18 }
      }
    },
    "exact_kv": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "coefficient", "scale"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "coefficient": { "type": "string", "pattern": "^-?(0|[1-9][0-9]*)$" },
        "scale": { "type": "integer", "minimum": 0, "maximum": 18 }
      }
    },
    "context_v1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "strategy_id",
        "strategy_version",
        "account_id",
        "venue_id",
        "data_fingerprint",
        "as_of",
        "positions",
        "cash",
        "available_margin_raw",
        "risk_state"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "strategy_id": { "type": "string", "minLength": 1 },
        "strategy_version": { "type": "string", "minLength": 1 },
        "account_id": { "type": "string", "minLength": 1 },
        "venue_id": { "type": "string", "minLength": 1 },
        "data_fingerprint": { "type": "string", "minLength": 1 },
        "as_of": { "type": "integer", "minimum": 1 },
        "positions": { "type": "object", "additionalProperties": { "type": "integer" } },
        "cash": { "type": "object", "additionalProperties": { "type": "integer" } },
        "available_margin_raw": { "oneOf": [{ "type": "integer" }, { "type": "null" }] },
        "risk_state": { "type": "string", "minLength": 1 }
      }
    }
  }
}
