{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qianxing.local/schemas/provider-backtest-result-v1.json",
  "title": "Qianxing ProviderBacktestOutcome v1",
  "description": "Immutable Provider Bar dataset manifest, dataset usability verdict, shared Bar outcome and persisted manifest path.",
  "type": "object",
  "required": [
    "outcome",
    "dataset_verdict",
    "manifest",
    "manifest_path"
  ],
  "properties": {
    "outcome": {
      "$ref": "#/$defs/BacktestOutcome"
    },
    "dataset_verdict": {
      "$ref": "#/$defs/DatasetVerdict"
    },
    "manifest": {
      "$ref": "#/$defs/DatasetManifestV2"
    },
    "manifest_path": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "$defs": {
    "BacktestOutcome": {
      "type": "object",
      "required": [
        "run_id",
        "instrument",
        "result_hash",
        "data_fingerprint",
        "fills",
        "equity_points",
        "return_bps",
        "max_drawdown_bps",
        "artifacts"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "instrument": {
          "type": "string",
          "minLength": 1
        },
        "result_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "data_fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "fills": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "equity_points": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "return_bps": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "max_drawdown_bps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "artifacts": {
          "$ref": "#/$defs/BacktestArtifacts"
        },
        "account_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "DatasetVerdict": {
      "type": "object",
      "required": [
        "dataset_id",
        "instrument",
        "rows",
        "content_fingerprint",
        "usable",
        "gaps"
      ],
      "properties": {
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "instrument": {
          "type": "string",
          "minLength": 1
        },
        "rows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "content_fingerprint": {
          "type": "string",
          "pattern": "^barframe:[0-9a-f]{16}$"
        },
        "usable": {
          "type": "boolean"
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "usable": {
                "const": true
              }
            },
            "required": [
              "usable"
            ]
          },
          "then": {
            "properties": {
              "gaps": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "usable": {
                "const": false
              }
            },
            "required": [
              "usable"
            ]
          },
          "then": {
            "properties": {
              "gaps": {
                "minItems": 1
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "DatasetManifestV2": {
      "type": "object",
      "required": [
        "manifest_version",
        "dataset",
        "instrument",
        "timezone",
        "tier",
        "provider_version",
        "content_hash",
        "quality_report",
        "source_lineage"
      ],
      "properties": {
        "manifest_version": {
          "const": 1
        },
        "dataset": {
          "type": "object",
          "required": [
            "dataset_id",
            "version",
            "source",
            "fingerprint",
            "schema_version",
            "start_timestamp",
            "end_timestamp"
          ],
          "properties": {
            "dataset_id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "fingerprint": {
              "type": "string",
              "minLength": 1
            },
            "schema_version": {
              "type": "integer",
              "minimum": 1
            },
            "start_timestamp": {
              "type": "integer",
              "minimum": 1
            },
            "end_timestamp": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "instrument": {
          "type": "string",
          "minLength": 1
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "tier": {
          "enum": [
            "bar",
            "l1",
            "l2",
            "l3"
          ]
        },
        "provider_version": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "type": "string",
          "minLength": 1
        },
        "quality_report": {
          "type": "object",
          "required": [
            "row_count",
            "duplicate_rows",
            "out_of_order_rows",
            "missing_intervals",
            "timezone",
            "corporate_action_coverage",
            "usable_tiers"
          ],
          "properties": {
            "row_count": {
              "type": "integer",
              "minimum": 1
            },
            "duplicate_rows": {
              "type": "integer",
              "minimum": 0
            },
            "out_of_order_rows": {
              "type": "integer",
              "minimum": 0
            },
            "missing_intervals": {
              "type": "integer",
              "minimum": 0
            },
            "interval_ms": {
              "type": "integer",
              "minimum": 1
            },
            "timezone": {
              "type": "string",
              "minLength": 1
            },
            "corporate_action_coverage": {
              "type": "boolean"
            },
            "usable_tiers": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "bar",
                  "l1",
                  "l2",
                  "l3"
                ]
              }
            }
          },
          "additionalProperties": false
        },
        "source_lineage": {
          "type": "object",
          "required": [
            "primary_source"
          ],
          "properties": {
            "primary_source": {
              "type": "string",
              "minLength": 1
            },
            "backup_sources": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "BacktestArtifacts": {
      "type": "object",
      "required": [
        "run_manifest",
        "summary",
        "equity",
        "fills"
      ],
      "properties": {
        "run_manifest": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "equity": {
          "type": "string",
          "minLength": 1
        },
        "fills": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
