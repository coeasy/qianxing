{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qianxing.dev/schemas/strategy-pit-ledger-v1.json",
  "title": "Qianxing point-in-time data visibility ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "source", "facts"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "qianxing-pit-ledger" },
    "source": { "type": "string", "minLength": 1 },
    "price_adjustment_basis": {
      "type": "string",
      "enum": ["raw", "forward_adjusted", "backward_adjusted", "unknown"],
      "default": "unknown"
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact_id", "entity_id", "field", "effective_at", "versions"],
        "properties": {
          "fact_id": { "type": "string", "minLength": 1 },
          "entity_id": { "type": "string", "minLength": 1 },
          "field": { "type": "string", "minLength": 1 },
          "effective_at": { "type": "integer", "minimum": 1 },
          "versions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["available_at", "revision", "value_fingerprint"],
              "properties": {
                "available_at": {
                  "oneOf": [
                    { "type": "integer", "minimum": 1 },
                    { "type": "null" }
                  ]
                },
                "revision": { "type": "string", "minLength": 1 },
                "value_fingerprint": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
