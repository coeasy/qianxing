{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qianxing.local/schemas/dataset-bundle-v1.json",
  "title": "Qianxing Dataset Bundle v1",
  "description": "Deterministic component identities for a research dataset. Per-component DatasetSnapshotV1 metadata is included in the bundle fingerprint. Bundles with a bars component require a matching snapshot before persistence or strategy backtest execution; older snapshot-less JSON remains readable but is not execution-eligible.",
  "type": "object",
  "required": ["bundle_id", "version", "source", "schema_version", "components"],
  "properties": {
    "bundle_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "schema_version": {"type": "integer", "minimum": 1},
    "components": {
      "type": "object",
      "minProperties": 1,
      "required": ["bars"],
      "additionalProperties": {
        "type": "object",
        "required": ["kind", "dataset_id", "version", "source", "fingerprint", "schema_version", "start_timestamp", "end_timestamp", "row_count"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "format": {"enum": ["json", "arrow"]},
          "dataset_id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "fingerprint": {"type": "string", "minLength": 1},
          "schema_version": {"type": "integer", "minimum": 1},
          "start_timestamp": {"type": "integer", "minimum": 1},
          "end_timestamp": {"type": "integer", "minimum": 1},
          "row_count": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "snapshots": {
      "type": "object",
      "additionalProperties": {"$ref": "dataset-snapshot-v1.json"}
    }
  },
  "additionalProperties": false
}
