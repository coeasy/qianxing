{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qianxing.local/schemas/dataset-manifest-v2.json",
  "title": "Qianxing Dataset Manifest v2",
  "description": "数据集清单 v2：v1 身份作为嵌套子对象复用，另加 instrument/timezone/档位/provider 版本/内容 hash/质量报告/来源 lineage。manifest_version 与 crates/qx-data/src/catalog_v2.rs 的 DATASET_MANIFEST_V2_SCHEMA_VERSION 同源。备源只做回填/交叉校验，不得与主源同名。",
  "type": "object",
  "required": ["manifest_version", "dataset", "instrument", "timezone", "tier", "provider_version", "content_hash", "quality_report", "source_lineage"],
  "properties": {
    "manifest_version": {"const": 1},
    "dataset": {
      "type": "object",
      "required": ["dataset_id", "version", "source", "fingerprint", "schema_version", "start_timestamp", "end_timestamp"],
      "properties": {
        "dataset_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "fingerprint": {"type": "string", "minLength": 1},
        "schema_version": {"type": "integer", "minimum": 1},
        "start_timestamp": {"type": "integer", "minimum": 1},
        "end_timestamp": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "instrument": {"type": "string", "minLength": 1},
    "timezone": {"type": "string", "minLength": 1},
    "tier": {"enum": ["bar", "l1", "l2", "l3"]},
    "provider_version": {"type": "string", "minLength": 1},
    "content_hash": {"type": "string", "minLength": 1},
    "quality_report": {
      "type": "object",
      "required": ["row_count", "duplicate_rows", "out_of_order_rows", "missing_intervals", "timezone", "corporate_action_coverage", "usable_tiers"],
      "properties": {
        "row_count": {"type": "integer", "minimum": 1},
        "duplicate_rows": {"type": "integer", "minimum": 0},
        "out_of_order_rows": {"type": "integer", "minimum": 0},
        "missing_intervals": {"type": "integer", "minimum": 0},
        "timezone": {"type": "string", "minLength": 1},
        "corporate_action_coverage": {"type": "boolean"},
        "usable_tiers": {"type": "array", "minItems": 1, "items": {"enum": ["bar", "l1", "l2", "l3"]}}
      },
      "additionalProperties": false
    },
    "source_lineage": {
      "type": "object",
      "required": ["primary_source"],
      "properties": {
        "primary_source": {"type": "string", "minLength": 1},
        "backup_sources": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
