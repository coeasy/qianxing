{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qianxing.local/schemas/backtest-outcome-v1.json",
  "title": "Qianxing BacktestOutcome v1",
  "description": "Stable Bar backtest result identity and the four persisted artifact paths. account_id is omitted for legacy and non-account-aware runs.",
  "type": "object",
  "required": ["run_id", "instrument", "result_hash", "data_fingerprint", "fills", "equity_points", "return_bps", "max_drawdown_bps", "artifacts"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "instrument": {"type": "string", "minLength": 1},
    "result_hash": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "data_fingerprint": {"type": "string", "minLength": 1},
    "fills": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "equity_points": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "return_bps": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
    "max_drawdown_bps": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "artifacts": {"$ref": "#/$defs/BacktestArtifacts"},
    "account_id": {"type": ["string", "null"]}
  },
  "additionalProperties": false,
  "$defs": {
    "BacktestArtifacts": {
      "type": "object",
      "required": ["run_manifest", "summary", "equity", "fills"],
      "properties": {
        "run_manifest": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "equity": {"type": "string", "minLength": 1},
        "fills": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
