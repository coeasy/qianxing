{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qianxing.local/schemas/research-artifact-view-v10.json",
  "title": "Qianxing ResearchArtifactView v10",
  "description": "Replay-verified shared-account two-leg Bar report with per-leg input samples and a causally linked event timeline.",
  "type": "object",
  "required": [
    "schema_version",
    "run_kind",
    "run_id",
    "instrument",
    "verification",
    "summary",
    "equity",
    "fills",
    "events",
    "bars",
    "event_trace_available",
    "markets"
  ],
  "properties": {
    "schema_version": {
      "const": 10
    },
    "run_kind": {
      "const": "multi_leg"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "instrument": {
      "type": "string",
      "minLength": 1
    },
    "verification": {
      "$ref": "verification-result-v1.json"
    },
    "summary": {
      "type": "object",
      "additionalProperties": true
    },
    "equity": {
      "$ref": "research-artifact-view-v2.json#/$defs/equityRows"
    },
    "fills": {
      "$ref": "research-artifact-view-v2.json#/$defs/rows"
    },
    "events": {
      "$ref": "research-artifact-view-v2.json#/$defs/events"
    },
    "bars": {
      "$ref": "#/$defs/emptyBars"
    },
    "event_trace_available": {
      "const": true
    },
    "strategy_diagnostics": {
      "$ref": "#/$defs/boundStrategyDiagnostics"
    },
    "market_strategy_diagnostics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/boundStrategyDiagnostics"
      }
    },
    "markets": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/market"
      }
    }
  },
  "not": {
    "required": [
      "strategy_diagnostics",
      "market_strategy_diagnostics"
    ]
  },
  "$defs": {
    "emptyBars": {
      "type": "object",
      "required": [
        "source_status",
        "total",
        "truncated",
        "rows"
      ],
      "properties": {
        "source_status": {
          "const": "unsupported_input_kind"
        },
        "total": {
          "const": 0
        },
        "truncated": {
          "const": false
        },
        "rows": {
          "type": "array",
          "maxItems": 0
        }
      },
      "additionalProperties": false
    },
    "market": {
      "type": "object",
      "required": [
        "instrument",
        "data_fingerprint",
        "fill_count",
        "quality_status",
        "bars"
      ],
      "properties": {
        "instrument": {
          "type": "string",
          "minLength": 1
        },
        "data_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "fill_count": {
          "type": "integer",
          "minimum": 0
        },
        "quality_status": {
          "enum": [
            "verified",
            "not_provided"
          ]
        },
        "bars": {
          "$ref": "#/$defs/barView"
        }
      },
      "additionalProperties": false
    },
    "barView": {
      "type": "object",
      "required": [
        "source_status",
        "total",
        "truncated",
        "rows"
      ],
      "properties": {
        "source_status": {
          "const": "verified"
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "rows": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "research-artifact-view-v2.json#/$defs/barPoint"
          }
        }
      },
      "additionalProperties": false
    },
    "boundStrategyDiagnostics": {
      "type": "object",
      "required": [
        "identity_bound",
        "computation",
        "report"
      ],
      "properties": {
        "identity_bound": {
          "const": true
        },
        "computation": {
          "const": "client_computed_not_reexecuted_by_api"
        },
        "report": {
          "type": "object",
          "required": [
            "schema_version",
            "kind",
            "strategy_id",
            "instrument",
            "data_fingerprint",
            "as_of",
            "input_bars",
            "lookahead",
            "startup"
          ],
          "properties": {
            "schema_version": {
              "const": 1
            },
            "kind": {
              "const": "qianxing-strategy-bias-diagnostics"
            },
            "strategy_id": {
              "type": "string",
              "minLength": 1
            },
            "instrument": {
              "type": "string",
              "minLength": 1
            },
            "data_fingerprint": {
              "type": "string",
              "pattern": "^[0-9a-f]{16}$"
            },
            "as_of": {
              "type": "integer",
              "minimum": 0
            },
            "input_bars": {
              "type": "integer",
              "minimum": 1
            },
            "lookahead": {
              "type": "object"
            },
            "startup": {
              "type": "object"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
