{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qianxing.local/schemas/multi-market-event-report-page-v1.json",
  "title": "Qianxing Multi-Market Event Report Page v1",
  "type": "object",
  "oneOf": [
    {
      "title": "Read request",
      "required": ["schema_version", "outcome"],
      "properties": {
        "schema_version": {"const": 1},
        "outcome": {"$ref": "multi-market-backtest-result-v1.json"},
        "page": {
          "type": "object",
          "required": ["offset", "limit"],
          "properties": {
            "offset": {"type": "integer", "minimum": 0},
            "limit": {"type": "integer", "minimum": 1, "maximum": 300}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "title": "Read result",
      "required": ["schema_version", "run_id", "total", "offset", "truncated", "rows", "fill_count", "fill_sequence_sha256", "order_markets", "replayed_ledger_entries"],
      "properties": {
        "schema_version": {"const": 1},
        "run_id": {"type": "string", "minLength": 1},
        "total": {"type": "integer", "minimum": 0},
        "offset": {"type": "integer", "minimum": 0},
        "truncated": {"type": "boolean"},
        "rows": {"type": "array", "maxItems": 300, "items": {"type": "object"}},
        "fill_count": {"type": "integer", "minimum": 0},
        "fill_sequence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "order_markets": {"type": "object", "additionalProperties": {"type": "string"}},
        "replayed_ledger_entries": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  ]
}
