{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qianxing.local/schemas/research-artifact-request-v3.json",
  "title": "Qianxing ResearchArtifactRequest v3",
  "description": "Verified research artifact request with optional identity-bound strategy diagnostics for shared-account multi-market Bar reports.",
  "anyOf": [
    {
      "$ref": "backtest-outcome-v1.json"
    },
    {
      "$ref": "depth-backtest-outcome-v1.json"
    },
    {
      "$ref": "multi-market-backtest-outcome-v1.json"
    },
    {
      "$ref": "multi-market-depth-backtest-outcome-v1.json"
    },
    {
      "$ref": "multi-account-backtest-result-v1.json"
    },
    {
      "$ref": "multi-account-depth-backtest-result-v1.json"
    },
    {
      "type": "object",
      "required": [
        "outcome"
      ],
      "properties": {
        "outcome": {
          "anyOf": [
            {
              "$ref": "backtest-outcome-v1.json"
            },
            {
              "$ref": "depth-backtest-outcome-v1.json"
            },
            {
              "$ref": "multi-market-backtest-outcome-v1.json"
            },
            {
              "$ref": "multi-market-depth-backtest-outcome-v1.json"
            },
            {
              "$ref": "multi-account-backtest-result-v1.json"
            },
            {
              "$ref": "multi-account-depth-backtest-result-v1.json"
            }
          ]
        },
        "strategy_diagnostics": {
          "type": "object",
          "required": [
            "schema_version",
            "kind",
            "strategy_id",
            "instrument",
            "data_fingerprint",
            "as_of",
            "input_bars",
            "lookahead",
            "startup"
          ],
          "properties": {
            "schema_version": {
              "const": 1
            },
            "kind": {
              "const": "qianxing-strategy-bias-diagnostics"
            },
            "strategy_id": {
              "type": "string",
              "minLength": 1
            },
            "instrument": {
              "type": "string",
              "minLength": 1
            },
            "data_fingerprint": {
              "type": "string",
              "minLength": 1
            },
            "as_of": {
              "type": "integer",
              "minimum": 0
            },
            "input_bars": {
              "type": "integer",
              "minimum": 1
            },
            "lookahead": {
              "type": "object"
            },
            "startup": {
              "type": "object"
            }
          },
          "additionalProperties": true
        },
        "event_page": {
          "type": "object",
          "required": [
            "offset"
          ],
          "properties": {
            "offset": {
              "type": "integer",
              "minimum": 0
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300,
              "default": 300
            }
          },
          "additionalProperties": false
        },
        "account_event_offsets": {
          "type": "object",
          "description": "Per-account event cursors used to page the chronologically merged multi-account event timeline. The sum of these offsets must match event_page.offset.",
          "maxProperties": 32,
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "event_instrument": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "market_strategy_diagnostics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": {
            "type": "object",
            "required": [
              "schema_version",
              "kind",
              "strategy_id",
              "instrument",
              "data_fingerprint",
              "as_of",
              "input_bars",
              "lookahead",
              "startup"
            ],
            "properties": {
              "schema_version": {
                "const": 1
              },
              "kind": {
                "const": "qianxing-strategy-bias-diagnostics"
              },
              "strategy_id": {
                "type": "string",
                "minLength": 1
              },
              "instrument": {
                "type": "string",
                "minLength": 1
              },
              "data_fingerprint": {
                "type": "string",
                "minLength": 1
              },
              "as_of": {
                "type": "integer",
                "minimum": 0
              },
              "input_bars": {
                "type": "integer",
                "minimum": 1
              },
              "lookahead": {
                "type": "object"
              },
              "startup": {
                "type": "object"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "not": {
        "required": [
          "strategy_diagnostics",
          "market_strategy_diagnostics"
        ]
      },
      "additionalProperties": false
    }
  ]
}
