{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qianxing.local/schemas/run-record-v1.json",
  "title": "Qianxing Run Record v1",
  "description": "一次运行及其产物的可复核身份。schema_version 与 crates/qx-spec/src/run_record.rs 的 RUN_RECORD_SCHEMA_VERSION 同源。status=completed 必须在 validate 里同时满足 finished_at_ms 存在、replay_verdict=verified、且至少引用一份产物——这是对象层硬约束，不是文档承诺。",
  "type": "object",
  "required": ["schema_version", "run_id", "status", "input_digest", "code_identity", "config_fingerprint", "started_at_ms", "replay_verdict", "capability_level"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["pending", "running", "completed", "failed"]},
    "input_digest": {"type": "string", "minLength": 1},
    "code_identity": {"type": "string", "minLength": 1},
    "config_fingerprint": {"type": "string", "minLength": 1},
    "started_at_ms": {"type": "integer", "minimum": 0},
    "finished_at_ms": {"type": ["integer", "null"], "minimum": 0},
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path", "digest"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "digest": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "replay_verdict": {"enum": ["verified", "mismatch", "not_run"]},
    "capability_level": {"enum": ["L0", "L1", "L2", "L3", "L4"]}
  },
  "additionalProperties": false
}
