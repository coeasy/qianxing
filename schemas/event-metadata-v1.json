{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qianxing.dev/schema/event-metadata-v1.json",
  "title": "Qianxing Event Metadata v1",
  "description": "Historical event lineage metadata before source_kind was added. Readers retain unknown fields for forward compatibility.",
  "type": "object",
  "required": ["schema_version", "source_id", "dedup_key", "rule_version", "context"],
  "properties": {
    "schema_version": { "const": 1 },
    "source_id": { "type": "string" },
    "dedup_key": { "type": "string" },
    "rule_version": { "type": "string", "minLength": 1 },
    "context": {
      "type": "object",
      "required": ["tenant_id", "run_id", "account_id", "portfolio_id", "strategy_id", "signal_id", "intent_id"],
      "properties": {
        "tenant_id": { "type": "string" },
        "run_id": { "type": "string" },
        "account_id": { "type": "string" },
        "portfolio_id": { "type": "string" },
        "strategy_id": { "type": "string" },
        "signal_id": { "type": "string" },
        "intent_id": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
