{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qianxing.local/schemas/compare-runs-result-v1.json",
  "title": "Qianxing CompareRunsResult v1",
  "description": "Deterministically ranked comparison output; rank starts at one and uses return descending, drawdown ascending, then run_id ascending.",
  "type": "object",
  "required": [
    "schema_version",
    "instrument",
    "data_fingerprint",
    "runs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "instrument": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "data_fingerprint": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "runs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/ComparedRunResult"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ComparedRun": {
      "type": "object",
      "required": [
        "run_id",
        "instrument",
        "data_fingerprint",
        "result_hash",
        "return_bps",
        "max_drawdown_bps"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
        },
        "instrument": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
        },
        "data_fingerprint": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
        },
        "result_hash": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
        },
        "return_bps": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "max_drawdown_bps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      },
      "additionalProperties": false
    },
    "ComparedRunResult": {
      "type": "object",
      "required": [
        "rank",
        "run"
      ],
      "properties": {
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "run": {
          "$ref": "#/$defs/ComparedRun"
        }
      },
      "additionalProperties": false
    }
  }
}
