{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qianxing.dev/schema/event-metadata-v2.json",
  "title": "Qianxing Event Metadata v2",
  "description": "Current serialized event lineage metadata. source_kind is required in v2 output; readers default it to internal when replaying v1 records.",
  "type": "object",
  "required": ["schema_version", "source_id", "source_kind", "dedup_key", "rule_version", "context"],
  "properties": {
    "schema_version": { "const": 2 },
    "source_id": { "type": "string" },
    "source_kind": { "type": "string", "minLength": 1 },
    "dedup_key": { "type": "string" },
    "rule_version": { "type": "string", "minLength": 1 },
    "context": {
      "type": "object",
      "required": ["tenant_id", "run_id", "account_id", "portfolio_id", "strategy_id", "signal_id", "intent_id"],
      "properties": {
        "tenant_id": { "type": "string" },
        "run_id": { "type": "string" },
        "account_id": { "type": "string" },
        "portfolio_id": { "type": "string" },
        "strategy_id": { "type": "string" },
        "signal_id": { "type": "string" },
        "intent_id": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
