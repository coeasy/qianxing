{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qianxing.local/schemas/run-multi-market-experiment-result-v1.json",
  "title": "Qianxing RunMultiMarketExperimentResult v1",
  "description": "Bounded multi-market candidate results and deterministic return/drawdown ranking.",
  "type": "object",
  "required": ["schema_version", "experiment_id", "target_strategy_id", "spec_fingerprint", "total_candidates", "completed_candidates", "succeeded_candidates", "failed_candidates", "candidates", "ranking", "artifact_path"],
  "properties": {
    "schema_version": {"const": 1},
    "experiment_id": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[A-Za-z0-9._-]+$"},
    "target_strategy_id": {"type": "string", "minLength": 1},
    "spec_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "total_candidates": {"type": "integer", "minimum": 1, "maximum": 256},
    "completed_candidates": {"type": "integer", "minimum": 0, "maximum": 256},
    "succeeded_candidates": {"type": "integer", "minimum": 0, "maximum": 256},
    "failed_candidates": {"type": "integer", "minimum": 0, "maximum": 256},
    "candidates": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/Candidate"}},
    "ranking": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/RankedCandidate"}},
    "out_of_sample": {"$ref": "run-experiment-result-v1.json#/$defs/OutOfSampleReport"},
    "fold_candidate_failures": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/FoldCandidateFailure"}},
    "search": {"$ref": "#/$defs/SearchReport"},
    "artifact_path": {"type": "string", "minLength": 1},
    "canonical_run_spec_json": {"type": "string", "minLength": 2},
    "canonical_run_spec_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "input_data_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "result_hash": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "run_manifest": {"type": "string", "minLength": 1},
    "run_record": {"type": "string", "minLength": 1},
    "artifact_locations": {
      "type": "object",
      "required": ["experiment_report", "run_manifest", "experiment_input"],
      "properties": {
        "experiment_report": {"type": "string", "minLength": 1},
        "run_manifest": {"type": "string", "minLength": 1},
        "experiment_input": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Candidate": {
      "type": "object",
      "required": ["ordinal", "parameters", "outcome", "error"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 255},
        "strategy_kind": {"type": ["string", "null"]},
        "parameters": {"type": "object", "additionalProperties": {"type": "integer", "minimum": -170141183460469231731687303715884105728, "maximum": 170141183460469231731687303715884105727}},
        "outcome": {"anyOf": [{"$ref": "multi-market-backtest-result-v1.json"}, {"type": "null"}]},
        "error": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "RankedCandidate": {
      "type": "object",
      "required": ["rank", "ordinal", "run_id", "return_bps", "max_drawdown_bps", "shared_result_hash"],
      "properties": {
        "rank": {"type": "integer", "minimum": 1, "maximum": 256},
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 255},
        "run_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$"},
        "return_bps": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
        "max_drawdown_bps": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "shared_result_hash": {"type": "string", "pattern": "^[0-9a-f]{16}$"}
      },
      "additionalProperties": false
    },
    "FoldCandidateFailure": {
      "type": "object",
      "required": ["fold", "ordinal", "error"],
      "properties": {
        "fold": {"type": "integer", "minimum": 1, "maximum": 10000},
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 256},
        "error": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "SearchReport": {
      "type": "object",
      "required": ["algorithm", "objective", "seed", "budget", "fold_local_search", "fold_searches"],
      "properties": {
        "algorithm": {"enum": ["random", "tpe", "tpe_kde", "pareto_tpe"]},
        "objective": {"enum": ["return", "pareto_return_drawdown"]},
        "seed": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "budget": {"type": "integer", "minimum": 1, "maximum": 256},
        "max_training_drawdown_bps": {"type": "integer", "minimum": 0, "maximum": 10000},
        "fold_local_search": {"type": "boolean"},
        "fold_searches": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/FoldSearchReport"}}
      },
      "additionalProperties": false
    },
    "FoldSearchReport": {
      "type": "object",
      "required": ["fold", "seed", "train_range", "test_range", "trials"],
      "properties": {
        "fold": {"type": "integer", "minimum": 1, "maximum": 10000},
        "seed": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "train_range": {"$ref": "run-experiment-result-v1.json#/$defs/TimeRange"},
        "test_range": {"$ref": "run-experiment-result-v1.json#/$defs/TimeRange"},
        "trials": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "run-experiment-result-v1.json#/$defs/SearchTrial"}}
      },
      "additionalProperties": false
    }
  }
}
