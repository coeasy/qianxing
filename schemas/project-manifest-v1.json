{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qianxing.local/schemas/project-manifest-v1.json",
  "title": "Qianxing Project Manifest v1",
  "description": "统一项目入口的声明式身份。required 逐项等于 Rust 侧 ProjectManifest 的非 Option 字段；additionalProperties:false 等于 #[serde(deny_unknown_fields)]。profile 取值域与 crates/qx-spec/src/project.rs 的 PROJECT_PROFILES 同源，language 与 PROJECT_STRATEGY_LANGUAGES 同源。",
  "type": "object",
  "required": ["schema_version", "project_id", "profile", "runtime", "artifact_root", "datasets", "strategies"],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"type": "string", "minLength": 1},
    "profile": {
      "enum": ["ashare-research", "ashare-paper", "cn-futures-research", "cn-options-research", "global-equity-paper", "fx-paper", "crypto-paper", "crypto-testnet", "multi-venue-arb"]
    },
    "runtime": {"type": "string", "minLength": 1},
    "artifact_root": {"type": "string", "minLength": 1},
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["dataset_id", "version"],
        "properties": {
          "dataset_id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "strategies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["strategy_id", "language", "source"],
        "properties": {
          "strategy_id": {"type": "string", "minLength": 1},
          "language": {"enum": ["rust", "python", "cpp"]},
          "source": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
