{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qianxing.local/schemas/strategy-api-v1.json",
  "title": "Qianxing Strategy API v1",
  "description": "策略进程返回给运行时的 output 载荷。required 逐项等于 Rust 侧 StrategyContractOutput / StrategyContractIntent 的非 #[serde(default)] 字段；additionalProperties: false 等于这两个结构体的 #[serde(deny_unknown_fields)]。定点数量按 Rust i128 交换，只允许 JSON 整数：Rust 读写都是整数（含 i64 范围外），Python SDK 写的也是整数；十进制字符串会被运行时判为 invalid number，所以这里不放行字符串形态（见 $defs 的 raw_signed）。side/position_side/margin_mode/position_mode 按 Rust 序列化的规范小写形式约束；运行时读入时会先 to_ascii_lowercase，因此大写载荷能过运行时但过不了本 schema——这是有意的：schema 是作者侧的严格口径，比运行时严不会放行坏载荷。",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "strategy_id",
    "signal_id",
    "instrument",
    "target_qty",
    "confidence",
    "priority",
    "expires_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"type": "string", "minLength": 1},
    "strategy_id": {"type": "string", "minLength": 1},
    "signal_id": {"type": "integer", "minimum": 1},
    "instrument": {"type": "string", "minLength": 1},
    "target_qty": {"$ref": "#/$defs/raw_signed"},
    "confidence": {"$ref": "#/$defs/raw_signed"},
    "priority": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
    "expires_at": {"type": "integer", "minimum": 0},
    "intents": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/intent"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "raw_signed": {
      "description": "核心定点 raw 值（Rust i128，可负）：只允许 JSON 整数。serde_json 对 i128 既读写整数、也接受超出 i64 的整数；十进制字符串会被判 invalid number。",
      "type": "integer"
    },
    "raw_positive": {
      "description": "必须为正的定点 raw 值（Rust 侧 validate_for 同样拒绝 0 与负数）。",
      "type": "integer",
      "minimum": 1
    },
    "optional_raw_positive": {
      "description": "可缺省的定点值：null 表示沿用运行时默认档位。",
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/raw_positive"}]
    },
    "intent": {
      "type": "object",
      "required": ["intent_id", "instrument", "side", "qty_raw"],
      "properties": {
        "intent_id": {"type": "integer", "minimum": 1},
        "instrument": {"type": "string", "minLength": 1},
        "side": {"enum": ["buy", "sell"]},
        "qty_raw": {"$ref": "#/$defs/raw_positive"},
        "limit_price_raw": {"$ref": "#/$defs/optional_raw_positive"},
        "reduce_only": {"type": "boolean"},
        "post_only": {"type": "boolean"},
        "position_side": {"enum": ["net", "long", "short", null]},
        "margin_mode": {"enum": ["cash", "cross", "isolated", null]},
        "position_mode": {"enum": ["one_way", "hedge", null]},
        "leverage": {"type": ["integer", "null"], "minimum": 1}
      },
      "additionalProperties": false
    }
  }
}
