{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qianxing.local/schemas/provider-depth-backtest-result-v1.json",
  "title": "Qianxing ProviderDepthBacktestOutcome v1",
  "description": "Provider provenance and frozen depth input path wrapped around the shared depth backtest outcome.",
  "type": "object",
  "required": [
    "outcome",
    "provider_id",
    "provider_version",
    "request_id",
    "retry_chain",
    "source_hash",
    "depth_path"
  ],
  "properties": {
    "outcome": {
      "$ref": "depth-backtest-outcome-v1.json"
    },
    "provider_id": {
      "type": "string",
      "minLength": 1
    },
    "provider_version": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "retry_chain": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "depth_path": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
