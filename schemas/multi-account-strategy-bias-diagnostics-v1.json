{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qianxing.local/schemas/multi-account-strategy-bias-diagnostics-v1.json",
  "title": "Qianxing Multi-account Strategy Bias Diagnostics v1",
  "description": "Per-account, caller-computed strategy-bias reports for one multi-account Bar report. The CLI requires exact successful account coverage and rebinds each report to the verified strategy, instrument and data fingerprint.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "accounts"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "qianxing-multi-account-strategy-bias-diagnostics"},
    "accounts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["account_id", "report"],
        "properties": {
          "account_id": {"type": "string", "minLength": 1},
          "report": {
            "type": "object",
            "required": ["schema_version", "kind", "strategy_id", "instrument", "data_fingerprint", "as_of", "lookahead", "startup"],
            "properties": {
              "schema_version": {"const": 1},
              "kind": {"const": "qianxing-strategy-bias-diagnostics"},
              "strategy_id": {"type": "string", "minLength": 1},
              "instrument": {"type": "string", "minLength": 1},
              "data_fingerprint": {"type": "string", "minLength": 1},
              "input_kind": {"const": "bar"},
              "input_bars": {"type": "integer", "minimum": 0},
              "as_of": {"type": "integer", "minimum": 0},
              "lookahead": {
                "type": "object",
                "required": ["status"],
                "properties": {
                  "status": {"enum": ["potential_lookahead_detected", "no_change_detected", "insufficient_history", "insufficient_work_budget", "causal_event_contract"]}
                }
              },
              "startup": {
                "type": "object",
                "required": ["status"],
                "properties": {
                  "status": {"enum": ["startup_sensitive", "stable_across_requested_windows", "insufficient_reference_history", "insufficient_history"]}
                }
              },
              "data_visibility": {
                "type": "object",
                "required": ["status"],
                "properties": {
                  "status": {"enum": ["potential_pit_bias_detected", "visibility_unknown", "no_pit_bias_detected"]}
                }
              }
            }
          }
        }
      }
    }
  }
}
