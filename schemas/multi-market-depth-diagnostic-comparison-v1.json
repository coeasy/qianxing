{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qianxing.local/schemas/multi-market-depth-diagnostic-comparison-v1.json",
  "title": "Qianxing Multi-market Depth Diagnostic Comparison v1",
  "description": "为同一组多市场深度运行绑定逐运行策略诊断。每个 run_id 必须与报告 --against 集合精确一致；CLI 还会重开原始摘要并复核策略槽、输入指纹和事件覆盖。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "runs"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "qianxing-multi-market-depth-diagnostic-comparison" },
    "runs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_id", "diagnostics"],
        "properties": {
          "run_id": { "type": "string", "minLength": 1 },
          "diagnostics": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "required": [
                "schema_version",
                "kind",
                "strategy_id",
                "instrument",
                "data_fingerprint",
                "input_kind",
                "input_events",
                "as_of"
              ],
              "properties": {
                "schema_version": { "const": 1 },
                "kind": { "const": "qianxing-strategy-bias-diagnostics" },
                "strategy_id": { "type": "string", "minLength": 1 },
                "instrument": { "type": "string", "minLength": 1 },
                "data_fingerprint": { "type": "string", "minLength": 1 },
                "input_kind": {
                  "enum": ["depth_midpoint_bar", "tick", "order_book"]
                },
                "input_events": { "type": "integer", "minimum": 0 },
                "as_of": { "type": "integer", "minimum": 0 },
                "lookahead": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "enum": ["potential_lookahead_detected", "no_change_detected", "insufficient_history", "insufficient_work_budget", "causal_event_contract"]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
