{
  "title": "牵星 Qianxing 运行概览",
  "uid": "qianxing-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "tags": ["qianxing", "quant", "local-runtime"],
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "API 请求速率",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(rate(qx_api_requests_total[5m]))", "legendFormat": "请求/秒" }
      ]
    },
    {
      "id": 2,
      "title": "API 拒绝（限流 / 认证）",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "sum(rate(qx_api_rate_limit_rejected_total[5m]))", "legendFormat": "限流" },
        { "expr": "sum(rate(qx_api_authentication_rejected_total[5m]))", "legendFormat": "认证" }
      ]
    },
    {
      "id": 3,
      "title": "命令入队失败",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "sum(rate(qx_api_command_enqueue_failures_total[5m]))", "legendFormat": "入队失败/秒" }
      ]
    },
    {
      "id": 4,
      "title": "控制面 retired 命令 / 审计",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "sum(rate(qx_control_retired_commands_total[5m]))", "legendFormat": "retired 命令" },
        { "expr": "sum(rate(qx_control_retired_audit_records_total[5m]))", "legendFormat": "审计记录" }
      ]
    },
    {
      "id": 5,
      "title": "Worker 在线",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "targets": [
        { "expr": "max by (worker) (qx_worker_up)", "legendFormat": "{{worker}}" }
      ]
    },
    {
      "id": 6,
      "title": "Worker 心跳陈旧（秒）",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 16 },
      "targets": [
        { "expr": "time() - max by (worker) (qx_worker_heartbeat_timestamp_seconds)", "legendFormat": "{{worker}}" }
      ]
    },
    {
      "id": 7,
      "title": "Pipeline 失败",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        { "expr": "sum by (worker) (rate(qx_pipeline_failures_total[5m]))", "legendFormat": "{{worker}}" }
      ]
    },
    {
      "id": 8,
      "title": "Pipeline 摄入",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        { "expr": "sum(rate(qx_pipeline_ingest_attempts_total[5m]))", "legendFormat": "摄入尝试" },
        { "expr": "sum(rate(qx_pipeline_ingested_events_total[5m]))", "legendFormat": "已摄入事件" },
        { "expr": "sum(rate(qx_pipeline_deduplicated_events_total[5m]))", "legendFormat": "去重" }
      ]
    },
    {
      "id": 9,
      "title": "Pipeline 重试 / 刷新",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "targets": [
        { "expr": "sum(rate(qx_pipeline_transient_retries_total[5m]))", "legendFormat": "瞬时重试" },
        { "expr": "sum(rate(qx_pipeline_refreshes_total[5m]))", "legendFormat": "刷新" }
      ]
    },
    {
      "id": 10,
      "title": "持久运行 watcher 活跃量 / 上限",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "targets": [
        { "expr": "max(qx_app_run_watchers_active)", "legendFormat": "活跃 watcher" },
        { "expr": "max(qx_app_run_watcher_capacity)", "legendFormat": "容量上限" }
      ]
    },
    {
      "id": 11,
      "title": "持久运行 watcher 容量拒绝速率",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "targets": [
        { "expr": "sum(rate(qx_app_run_watcher_rejections_total[5m]))", "legendFormat": "拒绝/秒" }
      ]
    },
    {
      "id": 12,
      "title": "行情 / 执行 / 对账延迟 P95（秒）",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 48 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, worker) (rate(qx_ccxt_ohlcv_request_duration_seconds_bucket[5m])))", "legendFormat": "OHLCV · {{worker}}" },
        { "expr": "histogram_quantile(0.95, sum by (le, worker, port) (rate(qx_gateway_port_operation_duration_seconds_bucket[5m])))", "legendFormat": "{{port}} · {{worker}}" }
      ]
    },
    {
      "id": 13,
      "title": "任务 / 控制命令队列积压",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 56 },
      "targets": [
        { "expr": "qx_job_queue_pending", "legendFormat": "可领取任务" },
        { "expr": "qx_control_command_queue_pending", "legendFormat": "未确认命令" }
      ]
    },
    {
      "id": 14,
      "title": "队列最老等待年龄（秒）",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 56 },
      "targets": [
        { "expr": "qx_job_queue_oldest_age_seconds", "legendFormat": "任务队列" },
        { "expr": "qx_control_command_queue_oldest_age_seconds", "legendFormat": "控制命令队列" }
      ]
    },
    {
      "id": 15,
      "title": "未解决订单组 / 对账问题",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 64 },
      "targets": [
        { "expr": "sum by (account, venue) (qx_order_group_status{status=\"reconcile_required\"})", "legendFormat": "待人工对账 · {{account}} · {{venue}}" },
        { "expr": "sum(qx_reconcile_order_issues)", "legendFormat": "最新报告未解决订单问题" },
        { "expr": "qx_order_group_metrics_available", "legendFormat": "订单组指标可用" },
        { "expr": "qx_reconcile_metrics_available", "legendFormat": "对账报告指标可用" }
      ]
    },
    {
      "id": 16,
      "title": "交易网关错误类别速率",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 64 },
      "targets": [
        { "expr": "sum by (port, class) (rate(qx_gateway_port_errors_total[5m]))", "legendFormat": "{{port}} · {{class}}" }
      ]
    },
    {
      "id": 17,
      "title": "CCXT 行情限流重试速率",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 72 },
      "targets": [
        { "expr": "sum by (worker) (rate(qx_ccxt_ohlcv_rate_limit_retries_total[5m]))", "legendFormat": "{{worker}}" }
      ]
    },
    {
      "id": 18,
      "title": "持久队列指标采集可用性",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 72 },
      "targets": [
        { "expr": "qx_job_queue_metrics_available", "legendFormat": "任务队列" },
        { "expr": "qx_control_command_queue_metrics_available", "legendFormat": "控制命令队列" }
      ]
    }
  ]
}
