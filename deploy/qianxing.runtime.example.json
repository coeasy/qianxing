{
  "schema_version": 1,
  "environment": "paper",
  "api": {
    "bind": "127.0.0.1:8080",
    "transport": "plaintext",
    "tls": null,
    "operators": {}
  },
  "storage": {
    "backend": "files",
    "data_dir": "data/qianxing",
    "sqlite_path": null
  },
  "workers": [
    {
      "id": "api",
      "role": "api",
      "enabled": true,
      "account_id": null,
      "venue_id": null,
      "endpoint": null,
      "symbols": [],
      "credential_env": null
    },
    {
      "id": "binance-market-testnet",
      "role": "market_data",
      "enabled": true,
      "account_id": null,
      "venue_id": "binance-testnet",
      "endpoint": "wss://stream.testnet.binance.vision/ws",
      "symbols": ["BTCUSDT.BINANCE"],
      "credential_env": null
    },
    {
      "id": "scheduler",
      "role": "scheduler",
      "enabled": true,
      "account_id": null,
      "venue_id": null,
      "endpoint": null,
      "symbols": [],
      "credential_env": null
    },
    {
      "id": "strategy-paper",
      "role": "strategy",
      "enabled": true,
      "account_id": "main",
      "venue_id": "binance-testnet",
      "endpoint": null,
      "symbols": ["BTCUSDT.BINANCE"],
      "credential_env": null
    },
    {
      "id": "reconciler-main",
      "role": "reconciler",
      "enabled": false,
      "account_id": "main",
      "venue_id": "binance-testnet",
      "endpoint": null,
      "symbols": ["BTCUSDT.BINANCE"],
      "credential_env": {
        "api_key": "QX_BINANCE_TESTNET_API_KEY",
        "secret": "QX_BINANCE_TESTNET_API_SECRET"
      }
    },
    {
      "id": "binance-execution-main",
      "role": "execution",
      "enabled": false,
      "account_id": "main",
      "venue_id": "binance-testnet",
      "endpoint": null,
      "symbols": [],
      "credential_env": {
        "api_key": "QX_BINANCE_TESTNET_API_KEY",
        "secret": "QX_BINANCE_TESTNET_API_SECRET"
      }
    }
  ],
  "scheduler": {
    "state_path": "scheduler.json",
    "jobs_path": "qianxing.scheduler.jobs.example.json",
    "job_queue_path": "job-queue",
    "tick_interval_ms": 1000
  },
  "strategy": {
    "version": "paper-strategy-v1",
    "max_orders": 1000,
    "account_id": "main",
    "venue_id": "binance-testnet",
    "instrument": "BTCUSDT.BINANCE",
    "target_qty": 0
  },
  "shutdown_timeout_ms": 30000
}
