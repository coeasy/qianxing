      "bars_seen": {"BTCUSDT.BINANCE": 2},
      "last_bar_ts": {"BTCUSDT.BINANCE": 2},
      "warmup_completed": ["BTCUSDT.BINANCE"],
      "update_cursors": [
        {
          "account_id": "paper",
          "venue_id": "BINANCE",
          "event_seq": 24,
