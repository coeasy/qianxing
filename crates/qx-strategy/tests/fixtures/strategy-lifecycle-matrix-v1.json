    "on_start",
    "market:Bar:9",
    "warmup_complete:BTCUSDT.BINANCE:2",
    "market:Bar:10",
    "market:OrderBook:10",
    "market:Timer:1000",
    "on_error_v1:market_event",
    "order_status:24",
    "fill:24",
    "order_status:25",
    "fill:25",
    "order_status:24",
    "fill:24",
    "account_snapshot:0",
