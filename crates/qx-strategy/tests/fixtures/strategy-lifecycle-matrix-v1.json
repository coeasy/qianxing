    "strategy_state": {"bars_processed": 2}
  },
  "expected_checkpoint_after_restart": {
    "schema_version": 1,
    "strategy_id": "checkpoint-golden",
    "strategy_version": "1.0",
    "adapter_state": {
      "schema_version": 1,
      "bars_seen": {"BTCUSDT.BINANCE": 3},
      "last_bar_ts": {"BTCUSDT.BINANCE": 11},
      "warmup_completed": ["BTCUSDT.BINANCE"],
      "update_cursors": []
    },
    "strategy_state": {"bars_processed": 3}
  },
  "expected_checkpoint_resume_callbacks": [
    "on_restore",
    "market:Bar:11"
  ],
  "expected_account_checkpoint_after_first_batch": {
